# MongoDB connection string (Atlas or local)
MONGODB_URI=your-mongodb-connection-string

# JWT secret - generate a strong random 32+ char string
JWT_SECRET=generate-strong-random-32-char-string

PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# OpenAI API key - powers AI-based expense categorization (POST /api/categorize/suggest).
# Optional: if not set, categorization automatically falls back to the
# self-trained Naive Bayes classifier in services/categorizer.js (no external
# API call needed, works fully offline).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
